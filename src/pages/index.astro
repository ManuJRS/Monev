---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContentIntro from "../components/contentIntro.astro";
import GridProyects from "../components/GridProyects.astro";
import TwoColsLefts from "../components/TwoColsLefts.astro";
import TwoColsRight from "../components/TwoColsRight.astro";
import ContentSocial from "../components/ContentSocial.astro";
const titlePage = "Monev Mx - AGENCIA ESPECIALIZADA";
---

<BaseLayout titlePage={titlePage}>
    <!-- COMPONENTE DE PRESENTACION -->
    <ContentIntro
        titleOne="SOMOS UNA AGENCIA ESPECIALIZADA"
        descriptionOne="Monev es una agencia especializada en generar soluciones estratégicamente creativas para satisfacer las necesidades de sus clientes. Su metodología de trabajo está basada en el Design Thinking, centrada en el usuario y orientada a la acción"
        descriptionTwo="El objetivo de Monev es ofrecer soluciones innovadoras, reales, viables y alcanzables que ayuden a sus clientes a alcanzar sus objetivos."
    />
    <!-- COMPONENTE DE PROYECTOS -->
    <GridProyects
        imgOne="https://res.cloudinary.com/dronteu5m/image/upload/v1739413738/strapi-demo/830167181783921_6521dde2b2a11_29f1506e43.png"
        titleOne="Proyecto uno"
        textOne="este es el proyecto uno"
        dateOne="11/11/11"
        imgTwo="https://res.cloudinary.com/dronteu5m/image/upload/v1739413752/strapi-demo/9b3675181783921_6521dde2a01fd_d2564eb59e.png"
        titleTwo="Proyecto dos"
        textTwo="este es el proyecto dos"
        dateTwo="11/11/11"
        imgThree="https://res.cloudinary.com/dronteu5m/image/upload/v1739413753/strapi-demo/2a57f2181783921_6521dde2ba6f0_3924cdd127.png"
        titleThree="Proyecto tres"
        textThree="este es el proyecto tres"
        dateThree="11/11/11"
        imgFour="https://res.cloudinary.com/dronteu5m/image/upload/v1739413736/strapi-demo/f55d33181783921_6521dde2b478c_b8d5c684e8.png"
        titleFour="Proyecto cuatro"
        textFour="este es el proyecto cuatro"
        dateFour="11/11/11"
        imgFive="https://res.cloudinary.com/dronteu5m/image/upload/v1739413735/strapi-demo/brandtshirt_9be8b2402b.webp"
        titleFive="Proyecto cinco"
        textFive="este es el proyecto cinco"
        dateFive="11/11/11"
        imgSix="https://res.cloudinary.com/dronteu5m/image/upload/v1739413685/strapi-demo/beer_b8a76796d2.webp"
        titleSix="Proyecto seis"
        textSix="este es el proyecto seis"
        dateSix="11/11/11"
        imgSeven="https://res.cloudinary.com/dronteu5m/image/upload/v1739414119/strapi-demo/56c5fc181783921_6521dde2a88d4_fa3f9a7352.png"
        titleSeven="Proyecto siete"
        textSeven="este es el proyecto siete"
        dateSeven="11/11/11"
    />
    <!-- COMPONENTE DE NUESTROS SERVICIOS CON ENLACES A LA IZQUIERDA-->
    <div class="z-20 bg-gray-600 relative">
        <TwoColsLefts
            LeftlinkOne="Branding"
            Leftfirstlink="/"
            LeftlinkTwo="Publicidad"
            Leftsecondlink="/"
            LeftlinkThree="Proyectos"
            LeftthirdLink="/"
            LeftFirstTitle="Nuestros proyectos"
            LeftFirstText="Lorem ipsum dolor sit amet consectetur adipisicing elit. Asperiores labore temporibus consequatur veniam possimus, iure eius accusantium rem praesentium maxime pariatur aut vel ipsa repellendus ipsam dolor dolore excepturi commodi!"
